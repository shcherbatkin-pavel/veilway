# Managed by Veilway. This client installs only source-specific fail-closed routes.
client
proto udp4
dev {{ veilway_transit_tunnel_interface }}
topology subnet
remote {{ veilway_aws_public_ipv4 }} {{ veilway_transit_port }}
nobind
resolv-retry infinite
persist-key
persist-tun
route-nopull
remote-cert-tls server
verify-x509-name aws-transit name

ca /etc/veilway/pki/ca.crt
cert /etc/veilway/pki/transit-client/client.crt
key /etc/veilway/pki/transit-client/client.key
tls-crypt-v2 /etc/veilway/pki/transit-client/tls-crypt-v2-client.key

tls-version-min 1.3
tls-cert-profile preferred
data-ciphers CHACHA20-POLY1305:AES-256-GCM:AES-128-GCM
auth SHA256
allow-compression no

script-security 2
up /etc/openvpn/transit-route-up
up-restart
down-pre
down /etc/openvpn/transit-route-down

connect-retry 5 30
explicit-exit-notify 1
verb 3
mute 10
