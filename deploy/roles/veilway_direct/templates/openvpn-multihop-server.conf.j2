# Managed by Veilway. Yandex client ingress for the fail-closed AWS egress path.
port {{ veilway_multihop_ingress_port }}
proto udp4
dev {{ veilway_multihop_tunnel_interface }}
topology subnet
server {{ veilway_multihop_ipv4_cidr | veilway_network_address }} {{ veilway_multihop_ipv4_cidr | veilway_network_netmask }}
server-ipv6 {{ veilway_multihop_ipv6_cidr }}

ca /etc/veilway/pki/ca.crt
cert /etc/veilway/pki/multihop-ingress/server.crt
key /etc/veilway/pki/multihop-ingress/server.key
crl-verify /etc/veilway/pki/crl.pem
tls-crypt-v2 /etc/veilway/pki/multihop-ingress/tls-crypt-v2-server.key force-cookie
verify-client-cert require
remote-cert-tls client

dh none
ecdh-curve prime256v1
tls-version-min 1.3
tls-cert-profile preferred
data-ciphers CHACHA20-POLY1305:AES-256-GCM:AES-128-GCM
auth SHA256
allow-compression no

push "redirect-gateway def1 bypass-dhcp block-local ipv6"
push "dhcp-option DNS {{ veilway_transit_ipv4_cidr | veilway_network_first_host }}"

keepalive 10 60
explicit-exit-notify 1
persist-key
persist-tun
user openvpn
group openvpn
verb 3
mute 10
