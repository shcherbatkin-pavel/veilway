# Managed by Veilway.
port {{ veilway_openvpn_port }}
proto udp4
dev {{ veilway_tunnel_interface }}
topology subnet
server {{ veilway_vpn_ipv4_cidr | veilway_network_address }} {{ veilway_vpn_ipv4_cidr | veilway_network_netmask }}
{% if veilway_enable_ipv6 %}
server-ipv6 {{ veilway_vpn_ipv6_cidr }}
{% endif %}

ca /etc/veilway/pki/ca.crt
cert /etc/veilway/pki/server.crt
key /etc/veilway/pki/server.key
crl-verify /etc/veilway/pki/crl.pem
tls-crypt-v2 /etc/veilway/pki/tls-crypt-v2-server.key force-cookie
verify-client-cert require
remote-cert-tls client

dh none
ecdh-curve prime256v1
tls-version-min 1.3
tls-cert-profile preferred
data-ciphers CHACHA20-POLY1305:AES-256-GCM:AES-128-GCM
auth SHA256
allow-compression no

push "redirect-gateway def1 bypass-dhcp block-local{% if veilway_enable_ipv6 %} ipv6{% endif %}"
push "dhcp-option DNS {{ veilway_vpn_ipv4_cidr | veilway_network_first_host }}"
{% if not veilway_enable_ipv6 %}
push "block-ipv6"
{% endif %}

keepalive 10 60
explicit-exit-notify 1
persist-key
persist-tun
user openvpn
group openvpn
verb 3
mute 10
