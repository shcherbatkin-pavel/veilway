# Copy to .env, replace every placeholder and set mode 0600.
# This file is consumed only by scripts/deploy-web-control.py on the operator host.
# Do not source it. Placeholder values are rejected. See docs/profile-rollout.md.
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
ADMIN_GOOGLE_EMAIL=replace-with-your-google-email
# Existing encrypted CA password; never generate/replace a production CA automatically.
PKI_CA_PASSPHRASE=replace-with-existing-ca-passphrase
PKI_YC_ENDPOINT=replace-with-yc-public-ipv4
PKI_AWS_ENDPOINT=replace-with-aws-public-ipv4
POSTGRES_PASSWORD=replace-with-a-long-random-password
AWS_ACCESS_KEY_ID=replace-with-dedicated-iam-access-key-id
AWS_SECRET_ACCESS_KEY=replace-with-dedicated-iam-secret
AWS_REGION=eu-central-1
AWS_DIRECT_INSTANCE_ID=replace-with-aws-direct-instance-id
YC_REGION=ru-central1-a
YC_DIRECT_INSTANCE_ID=replace-with-yc-direct-instance-id
HEARTBEAT_AWS_DIRECT_TOKEN=replace-with-at-least-32-random-characters
HEARTBEAT_YC_DIRECT_TOKEN=replace-with-at-least-32-random-characters

# Separate outbound CRL credentials; never reuse heartbeat tokens.
CRL_AWS_DIRECT_TOKEN=replace-with-unique-random-crl-aws-token
CRL_YC_DIRECT_TOKEN=replace-with-unique-random-crl-yc-token
