#!/usr/bin/env bash

set -euo pipefail

umask 077

readonly PROGRAM_NAME="${0##*/}"
readonly SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
readonly REPOSITORY_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd -P)"
readonly PROFILES_DIR="${REPOSITORY_ROOT}/client-profiles"
readonly ENDPOINT_CONFIG="${REPOSITORY_ROOT}/operator-config/endpoints.conf"
readonly CA_CERTIFICATE="${REPOSITORY_ROOT}/secrets/pki/ca/ca.crt"
readonly CRL_FILE="${REPOSITORY_ROOT}/secrets/pki/crl.pem"
readonly -a DIRECT_PROFILE_NAMES=(
    ubuntu-yc-direct
    iphone-yc-direct
    ubuntu-aws-direct
    iphone-aws-direct
)
readonly -a MULTIHOP_PROFILE_NAMES=(
    ubuntu-yc-aws-multihop
    iphone-yc-aws-multihop
)
temporary_directory=""

fail() {
    printf '%s: %s\n' "${PROGRAM_NAME}" "$*" >&2
    exit 1
}

require_command() {
    command -v -- "$1" >/dev/null 2>&1 \
        || fail "required command is unavailable: $1"
}

extract_section() {
    local tag="$1"
    local source_file="$2"
    local destination_file="$3"

    awk -v opening="<${tag}>" -v closing="</${tag}>" '
        $0 == opening { inside = 1; next }
        $0 == closing { inside = 0; found = 1; next }
        inside { print }
        END { if (!found) exit 1 }
    ' "${source_file}" > "${destination_file}"
    [[ -s "${destination_file}" ]] || return 1
    chmod 0600 -- "${destination_file}"
}

section_hash() {
    local tag="$1"
    local profile_path="$2"

    awk -v opening="<${tag}>" -v closing="</${tag}>" '
        $0 == opening { inside = 1; next }
        $0 == closing { inside = 0; found = 1; next }
        inside { print }
        END { if (!found) exit 1 }
    ' "${profile_path}" \
        | sha256sum \
        | awk '{ print $1 }'
}

read_endpoint() {
    local wanted_key="$1"
    local key value selected=""

    while IFS='=' read -r key value; do
        [[ "${key}" == "${wanted_key}" ]] || continue
        [[ -z "${selected}" ]] || return 1
        selected="${value}"
    done < "${ENDPOINT_CONFIG}"
    [[ -n "${selected}" ]] || return 1
    printf '%s\n' "${selected}"
}

cleanup() {
    [[ -n "${temporary_directory}" ]] || return 0
    case "${temporary_directory}" in
        /tmp/veilway-profile-verify.*)
            rm -rf -- "${temporary_directory}"
            ;;
        *)
            printf '%s: refusing unexpected cleanup path\n' "${PROGRAM_NAME}" >&2
            return 1
            ;;
    esac
}

main() {
    local profile_name profile_path mode endpoint port expected_remote
    local certificate_file private_key_file
    local certificate_public_key private_public_key
    local transit_directory transit_certificate transit_private_key transit_tls_key
    local yc_endpoint aws_endpoint yc_state_endpoint aws_state_endpoint
    local expected_ca_hash
    local expected_profile_count discovered_profile_count discovered_profile_path
    local discovered_profile_name
    local -a profile_names=("${DIRECT_PROFILE_NAMES[@]}")
    local -A certificate_hashes=()
    local -A private_key_hashes=()
    local -A tls_key_hashes=()

    if [[ $# -eq 1 && "$1" == '--direct-only' ]]; then
        expected_profile_count=4
    elif [[ $# -eq 0 ]]; then
        profile_names+=("${MULTIHOP_PROFILE_NAMES[@]}")
        expected_profile_count=6
    else
        fail "usage: ${PROGRAM_NAME} [--direct-only]"
    fi

    for command_name in awk chmod cmp find git grep mktemp openssl python3 rm sed sha256sum stat wc; do
        require_command "${command_name}"
    done

    [[ -d "${PROFILES_DIR}" && ! -L "${PROFILES_DIR}" ]] \
        || fail "client-profiles must be a regular directory"
    [[ "$(stat -c '%a' -- "${PROFILES_DIR}")" == "700" ]] \
        || fail "client-profiles directory mode must be 0700"
    [[ -f "${ENDPOINT_CONFIG}" && ! -L "${ENDPOINT_CONFIG}" ]] \
        || fail "endpoint configuration is missing or symlinked"
    [[ "$(stat -c '%a' -- "${ENDPOINT_CONFIG}")" == "600" ]] \
        || fail "endpoint configuration mode must be 0600"
    [[ -f "${CA_CERTIFICATE}" && ! -L "${CA_CERTIFICATE}" ]] \
        || fail "CA certificate is missing or symlinked"
    [[ -f "${CRL_FILE}" && ! -L "${CRL_FILE}" ]] \
        || fail "CRL is missing or symlinked"
    discovered_profile_count="$(find "${PROFILES_DIR}" -maxdepth 1 -name '*.ovpn' | wc -l)"
    if [[ "${expected_profile_count}" -eq 4 ]]; then
        [[ "${discovered_profile_count}" -eq 4 || "${discovered_profile_count}" -eq 6 ]] \
            || fail "expected four Direct profiles and optionally two multi-hop profiles"
    else
        [[ "${discovered_profile_count}" -eq 6 ]] \
            || fail "expected exactly six client profiles"
    fi
    while IFS= read -r discovered_profile_path; do
        discovered_profile_name="${discovered_profile_path##*/}"
        case "${discovered_profile_name}" in
            ubuntu-yc-direct.ovpn|iphone-yc-direct.ovpn|ubuntu-aws-direct.ovpn|iphone-aws-direct.ovpn|ubuntu-yc-aws-multihop.ovpn|iphone-yc-aws-multihop.ovpn)
                ;;
            *)
                fail "unexpected client profile: ${discovered_profile_name}"
                ;;
        esac
    done < <(find "${PROFILES_DIR}" -maxdepth 1 -name '*.ovpn' -print)

    yc_endpoint="$(read_endpoint yc_direct_endpoint)" \
        || fail "invalid yc_direct_endpoint"
    aws_endpoint="$(read_endpoint aws_direct_endpoint)" \
        || fail "invalid aws_direct_endpoint"
    yc_state_endpoint="$(
        python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["outputs"]["public_ipv4"]["value"])' \
            "${REPOSITORY_ROOT}/infra/yandex/terraform.tfstate"
    )"
    aws_state_endpoint="$(
        python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["outputs"]["public_ipv4"]["value"])' \
            "${REPOSITORY_ROOT}/infra/aws/terraform.tfstate"
    )"
    [[ "${yc_endpoint}" == "${yc_state_endpoint}" \
        && "${aws_endpoint}" == "${aws_state_endpoint}" ]] \
        || fail "profile endpoints do not match Terraform state"

    temporary_directory="$(mktemp -d -- /tmp/veilway-profile-verify.XXXXXXXXXX)"
    trap cleanup EXIT

    expected_ca_hash="$(
        sed -n '/-----BEGIN CERTIFICATE-----/,/-----END CERTIFICATE-----/p' \
            "${CA_CERTIFICATE}" | sha256sum | awk '{ print $1 }'
    )"

    for profile_name in "${profile_names[@]}"; do
        profile_path="${PROFILES_DIR}/${profile_name}.ovpn"
        [[ -f "${profile_path}" && ! -L "${profile_path}" ]] \
            || fail "missing regular profile: ${profile_name}"
        [[ "$(stat -c '%a' -- "${profile_path}")" == "600" ]] \
            || fail "profile mode must be 0600: ${profile_name}"
        git check-ignore --quiet --no-index -- "${profile_path}" \
            || fail "profile is not ignored by Git: ${profile_name}"

        case "${profile_name}" in
            *-yc-direct)
                mode="yc-direct"
                endpoint="${yc_endpoint}"
                port=1194
                grep -Fxq -- 'block-ipv6' "${profile_path}" \
                    || fail "yc-direct profile does not block IPv6: ${profile_name}"
                ;;
            *-aws-direct)
                mode="aws-direct"
                endpoint="${aws_endpoint}"
                port=1194
                if grep -Fxq -- 'block-ipv6' "${profile_path}"; then
                    fail "aws-direct profile unexpectedly blocks IPv6: ${profile_name}"
                fi
                ;;
            *-yc-aws-multihop)
                mode="yc-multihop-ingress"
                endpoint="${yc_endpoint}"
                port=1195
                if grep -Fxq -- 'block-ipv6' "${profile_path}"; then
                    fail "multi-hop profile unexpectedly blocks IPv6: ${profile_name}"
                fi
                ;;
        esac

        expected_remote="remote ${endpoint} ${port}"
        [[ "$(grep -Fxc -- "${expected_remote}" "${profile_path}")" -eq 1 ]] \
            || fail "profile has an unexpected endpoint: ${profile_name}"
        grep -Fxq -- 'proto udp4' "${profile_path}" \
            || fail "profile does not use udp4 transport: ${profile_name}"
        grep -Fxq -- "verify-x509-name ${mode} name" "${profile_path}" \
            || fail "profile server identity constraint is invalid: ${profile_name}"
        grep -Fxq -- 'tls-version-min 1.3' "${profile_path}" \
            || fail "profile TLS minimum is invalid: ${profile_name}"
        grep -Fxq -- 'allow-compression no' "${profile_path}" \
            || fail "profile compression policy is invalid: ${profile_name}"

        certificate_file="${temporary_directory}/${profile_name}.crt"
        private_key_file="${temporary_directory}/${profile_name}.key"
        certificate_public_key="${temporary_directory}/${profile_name}.cert.pub"
        private_public_key="${temporary_directory}/${profile_name}.key.pub"
        extract_section cert "${profile_path}" "${certificate_file}" \
            || fail "profile certificate section is invalid: ${profile_name}"
        extract_section key "${profile_path}" "${private_key_file}" \
            || fail "profile private-key section is invalid: ${profile_name}"

        openssl verify \
            -crl_check \
            -purpose sslclient \
            -CAfile "${CA_CERTIFICATE}" \
            -CRLfile "${CRL_FILE}" \
            "${certificate_file}" >/dev/null 2>&1 \
            || fail "profile certificate or CRL validation failed: ${profile_name}"
        openssl x509 \
            -in "${certificate_file}" \
            -noout \
            -checkhost "${profile_name}" >/dev/null 2>&1 \
            || fail "profile certificate identity is invalid: ${profile_name}"
        openssl x509 \
            -in "${certificate_file}" \
            -pubkey \
            -noout \
            | openssl pkey -pubin -outform DER > "${certificate_public_key}" 2>/dev/null
        openssl pkey \
            -in "${private_key_file}" \
            -pubout \
            -outform DER > "${private_public_key}" 2>/dev/null
        cmp -s -- "${certificate_public_key}" "${private_public_key}" \
            || fail "profile certificate and private key do not match: ${profile_name}"

        [[ "$(section_hash ca "${profile_path}")" == "${expected_ca_hash}" ]] \
            || fail "profile embeds an unexpected CA: ${profile_name}"
        certificate_hashes["$(section_hash cert "${profile_path}")"]=1
        private_key_hashes["$(section_hash key "${profile_path}")"]=1
        tls_key_hashes["$(section_hash tls-crypt-v2 "${profile_path}")"]=1
    done

    if [[ "${expected_profile_count}" -eq 6 ]]; then
        transit_directory="${REPOSITORY_ROOT}/secrets/pki/endpoints/yc-transit"
        transit_certificate="${transit_directory}/client.crt"
        transit_private_key="${transit_directory}/client.key"
        transit_tls_key="${transit_directory}/tls-crypt-v2-client.key"
        [[ -d "${transit_directory}" && ! -L "${transit_directory}" ]] \
            || fail 'transit identity directory is missing or symlinked'
        [[ "$(stat -c '%a' -- "${transit_directory}")" == '700' ]] \
            || fail 'transit identity directory mode must be 0700'
        for profile_path in "${transit_certificate}" "${transit_private_key}" "${transit_tls_key}"; do
            [[ -f "${profile_path}" && ! -L "${profile_path}" ]] \
                || fail 'transit identity file is missing or symlinked'
            git check-ignore --quiet --no-index -- "${profile_path}" \
                || fail 'transit identity file is not ignored by Git'
        done
        [[ "$(stat -c '%a' -- "${transit_certificate}")" == '644' ]] \
            || fail 'transit certificate mode must be 0644'
        [[ "$(stat -c '%a' -- "${transit_private_key}")" == '600' ]] \
            || fail 'transit private key mode must be 0600'
        [[ "$(stat -c '%a' -- "${transit_tls_key}")" == '600' ]] \
            || fail 'transit tls-crypt-v2 key mode must be 0600'
        grep -Fq -- '-----BEGIN OpenVPN tls-crypt-v2 client key-----' \
            "${transit_tls_key}" \
            || fail 'transit tls-crypt-v2 key is invalid'
        openssl verify \
            -crl_check \
            -purpose sslclient \
            -CAfile "${CA_CERTIFICATE}" \
            -CRLfile "${CRL_FILE}" \
            "${transit_certificate}" >/dev/null 2>&1 \
            || fail 'transit client certificate or CRL validation failed'
        openssl x509 \
            -in "${transit_certificate}" \
            -noout \
            -checkhost yc-transit >/dev/null 2>&1 \
            || fail 'transit client certificate identity is invalid'
        openssl x509 \
            -in "${transit_certificate}" \
            -pubkey \
            -noout \
            | openssl pkey -pubin -outform DER \
                > "${temporary_directory}/yc-transit.cert.pub" 2>/dev/null
        openssl pkey \
            -in "${transit_private_key}" \
            -pubout \
            -outform DER > "${temporary_directory}/yc-transit.key.pub" 2>/dev/null
        cmp -s -- \
            "${temporary_directory}/yc-transit.cert.pub" \
            "${temporary_directory}/yc-transit.key.pub" \
            || fail 'transit certificate and private key do not match'
        printf '%s\n' 'Yandex-to-AWS transit identity validation: passed'
    fi

    [[ "${#certificate_hashes[@]}" -eq "${expected_profile_count}" ]] \
        || fail "client certificates are not unique"
    [[ "${#private_key_hashes[@]}" -eq "${expected_profile_count}" ]] \
        || fail "client private keys are not unique"
    [[ "${#tls_key_hashes[@]}" -eq "${expected_profile_count}" ]] \
        || fail "tls-crypt-v2 client keys are not unique"

    printf '%s\n' 'client profile files and permissions: passed'
    printf '%s\n' 'client profile endpoints and routing policy: passed'
    printf '%s\n' 'client certificate, key, and CRL validation: passed'
    printf '%s unique client identities and tls-crypt-v2 keys: passed\n' \
        "${expected_profile_count}"
}

main "$@"
