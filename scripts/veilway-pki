#!/usr/bin/env bash

set -euo pipefail

umask 077

readonly PROGRAM_NAME="${0##*/}"
readonly SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
readonly REPOSITORY_ROOT="$(cd -- "${SCRIPT_DIR}/.." && pwd -P)"
readonly SECRETS_ROOT="${REPOSITORY_ROOT}/secrets"
readonly PKI_ROOT="${SECRETS_ROOT}/pki"
readonly CA_DIR="${PKI_ROOT}/ca"
readonly CLIENTS_DIR="${PKI_ROOT}/clients"
readonly ENDPOINTS_DIR="${PKI_ROOT}/endpoints"
readonly TEMP_ROOT="${PKI_ROOT}/tmp"
readonly PROFILES_DIR="${REPOSITORY_ROOT}/client-profiles"
readonly ENDPOINT_CONFIG="${REPOSITORY_ROOT}/operator-config/endpoints.conf"
readonly OPENSSL_CONFIG="${REPOSITORY_ROOT}/pki/openssl-ca.cnf"
readonly VPN_IMAGE="veilway/openvpn:2.6-ubuntu24.04"

usage() {
    cat <<EOF
Usage:
  ${PROGRAM_NAME} init
  ${PROGRAM_NAME} server create --mode <yc-direct|aws-direct|yc-multihop-ingress|aws-transit>
  ${PROGRAM_NAME} transit create
  ${PROGRAM_NAME} profile create --device <device-id> --mode <yc-direct|aws-direct|yc-aws-multihop> [--valid-for <positive integer m|mo> | --expires-at <ISO-8601 with timezone>]
  ${PROGRAM_NAME} profile update-remote --mode <yc-direct|aws-direct|yc-aws-multihop>
  ${PROGRAM_NAME} profile revoke --name <profile-name>

All private material is written under the Git-ignored secrets/ and
client-profiles/ directories with restrictive permissions. The CA passphrase is
entered directly into OpenSSL and is never accepted as a command-line option.
EOF
}

# shellcheck source=lib/pki/common.sh
source "${SCRIPT_DIR}/lib/pki/common.sh"
# shellcheck source=lib/pki/ca.sh
source "${SCRIPT_DIR}/lib/pki/ca.sh"
# shellcheck source=lib/pki/identities.sh
source "${SCRIPT_DIR}/lib/pki/identities.sh"
# shellcheck source=lib/pki/profiles.sh
source "${SCRIPT_DIR}/lib/pki/profiles.sh"
# shellcheck source=lib/pki/revoke.sh
source "${SCRIPT_DIR}/lib/pki/revoke.sh"

parse_mode_option() {
    [[ $# -eq 2 && "$1" == "--mode" ]] || fail "expected --mode <mode>"
    printf '%s\n' "$2"
}

main() {
    local mode device profile_name

    [[ $# -ge 1 ]] || {
        usage >&2
        exit 2
    }

    validate_private_roots

    case "$1" in
        init)
            [[ $# -eq 1 ]] || fail "init accepts no arguments"
            initialize_ca
            ;;
        server)
            [[ $# -eq 4 && "$2" == "create" ]] || fail "expected: server create --mode <mode>"
            mode="$(parse_mode_option "$3" "$4")"
            create_server "${mode}"
            ;;
        transit)
            [[ $# -eq 2 && "$2" == "create" ]] || fail "expected: transit create"
            create_transit_client
            ;;
        profile)
            [[ $# -ge 2 ]] || fail "profile requires create, update-remote, or revoke"
            case "$2" in
                create)
                    [[ $# -ge 6 && "$3" == "--device" && "$5" == "--mode" ]] || \
                        fail "expected: profile create --device <device> --mode <mode>"
                    device="$4"
                    mode="$6"
                    shift 6
                    [[ $# -eq 0 || ( $# -eq 2 && ( "$1" == '--valid-for' || "$1" == '--expires-at' ) ) ]] \
                        || fail 'expected at most one --valid-for or --expires-at option'
                    create_profile "${device}" "${mode}" "$@"
                    ;;
                update-remote)
                    [[ $# -eq 4 && "$3" == "--mode" ]] || \
                        fail "expected: profile update-remote --mode <mode>"
                    mode="$4"
                    update_profile_remotes "${mode}"
                    ;;
                revoke)
                    [[ $# -eq 4 && "$3" == "--name" ]] || fail "expected: profile revoke --name <profile-name>"
                    profile_name="$4"
                    revoke_profile "${profile_name}"
                    ;;
                *)
                    fail "profile requires create, update-remote, or revoke"
                    ;;
            esac
            ;;
        --help|-h)
            usage
            ;;
        *)
            usage >&2
            exit 2
            ;;
    esac
}

main "$@"
