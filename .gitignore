!/operator-config/endpoints.conf.example

# Terraform local state, plans, and credentials
**/.terraform/*
*.tfstate
*.tfstate.*
*.tfplan
*.tfplan.*
crash.log
crash.*.log
*.tfvars
!*.tfvars.example
.terraformrc
terraform.rc

# Local deployment inventory and generated configuration
/deploy/inventory.yml
/deploy/host_vars/
/deploy/generated/

# Safe documentation and configuration templates may be committed
!*.example
!*.example.*

# Editor and operating-system files
.idea/
.vscode/
.DS_Store
Thumbs.db
