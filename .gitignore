# VM audit output and exports
/audit-results/
audit-results*.tar
audit-results*.tar.*
audit-results*.zip
audit-*.tar
audit-*.tar.*
audit-*.zip

# Logs and temporary files
*.log
/logs/
__pycache__/
*.py[cod]
*.tmp
*.temp
*.swp
*.swo
*~

# Local environment and secrets
.env
.env.*
!.env.example
/secrets/
/private/

# SSH keys
id_rsa
id_rsa.*
id_dsa
id_dsa.*
id_ecdsa
id_ecdsa.*
id_ed25519
id_ed25519.*
*.ppk

# VPN keys, certificates, and client profiles
*.key
*.pem
*.p12
*.pfx
*.crt
*.cer
*.csr
*.ovpn
*.mobileconfig
wg*.conf
openvpn*.conf
/client-profiles/
/vpn-profiles/
